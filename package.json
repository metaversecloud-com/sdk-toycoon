    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "nodemon": "^1.14.10",
    "prettier": "3.2.5",
    "typescript": "^5.4.3"
  },
  "workspaces": [
    "client",
    "server"
  ]
}
